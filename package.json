{
  "name": "assui",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com:SPOTEC-LTD/assui.git"
  },
  "scripts": {
    "dumi:prepare": "dumi setup",
    "preinstall": "npx npm-force-resolutions",
    "prepare": "husky install",
    "init": "rm -rf node_modules && yarn install && yarn run clean && yarn run bootstrap && yarn run build",
    "start": "yarn run dev",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider dumi dev",
    "bootstrap": "lerna bootstrap",
    "clean": "lerna clean --yes",
    "build": "lerna run build",
    "build:i18n": "cross-env tsx ./i18n.ts",
    "lerna": "lerna",
    "test:watch": "jest --watch",
    "test": "jest",
    "tsc": "tsc --noEmit",
    "lint": "node buildITools/constFunctionPadding.js && biome check ./packages && stylelint \"packages/**/*.less\"",
    "lint:fix": "node buildITools/constFunctionPadding.js --fix && biome check --write --unsafe ./packages && stylelint --fix \"packages/**/*.less\" --custom-syntax postcss-less",
    "format": "yarn lint:fix",
    "pub:doc": "dumi build && gh-pages -d dist",
    "gh-pages": "gh-pages -d dist",
    "pub:doc-gitee": "npm run build:doc && cd ./dist && rm -rf .git && touch .spa && touch .nojekyll && git init && git remote add origin git@gitee.com:uso/sui.git && git add -A && git commit -m \"publish docs\" && git push origin master -f",
    "pub": "lerna publish",
    "dbuild": "dumi build",
    "preview": "dumi build && dumi preview"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "node buildITools/constFunctionPadding.js --fix",
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.less": [
      "stylelint --fix --custom-syntax postcss-less"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.10.1",
    "@babel/core": "^7.10.2",
    "@babel/preset-env": "^7.15.6",
    "@babel/preset-react": "^7.14.5",
    "@biomejs/biome": "2.5.6",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.2.1",
    "@types/jest": "^29.5.0",
    "@types/lodash.debounce": "^4.0.6",
    "@types/lodash.isequal": "^4.5.5",
    "@types/lodash.throttle": "^4.1.6",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@umijs/plugin-sass": "^1.1.1",
    "antd": "^4.24.16",
    "babel-loader": "^8.1.0",
    "babel-plugin-import": "^1.13.5",
    "babel-plugin-transform-async-to-promises": "^0.8.15",
    "code-rule": "2.0.3",
    "cross-env": "^7.0.3",
    "del": "^5.1.0",
    "dumi": "^2.4.49",
    "dumi-theme-mobile": "^2.3.5",
    "gh-pages": "^6.3.0",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-typescript": "^6.0.0-alpha.1",
    "husky": "^7.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "lerna": "^4.0.0",
    "less": "^4.1.1",
    "less-plugin-npm-import": "^2.1.0",
    "lint-staged": "^17.2.0",
    "memoize-one": "^5.2.1",
    "mockdate": "^3.0.2",
    "mockjs": "^1.1.0",
    "react": "18.3.1",
    "react-color": "^2.19.3",
    "react-copy-to-clipboard": "^5.0.3",
    "react-countup": "^6.5.3",
    "react-dom": "18.3.1",
    "react-drag-listview": "^0.1.6",
    "react-intl": "^7.1.14",
    "react-test-renderer": "18.3.1",
    "react-vant": "^3.3.5",
    "surge": "^0.21.3",
    "ts-jest": "^29.1.0",
    "tsx": "^4.23.5",
    "typescript": "^5.6.2",
    "umi-request": "^1.2.18",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-merge": "^6.0.1"
  },
  "resolutions": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "rc-select": "~14.1.18"
  }
}
