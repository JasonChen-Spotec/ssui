{
  "presets": [
    [
      "@babel/env",
      {
        "loose": true,
        "modules": false
      }
    ],
    [
      "@babel/react",
      {
        "runtime": "automatic"
      }
    ]
  ],
  "include": "**/*.js",
  "exclude": "**/*.ts",
  "plugins": [
    "babel-plugin-transform-async-to-promises"
  ]
}
